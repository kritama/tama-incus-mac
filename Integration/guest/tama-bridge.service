[Unit]
Description=Host-only Incus vsock bridge
Requires=tama-storage.service
After=tama-storage.service incus.service

[Service]
ExecStart=/usr/bin/python3 /usr/local/libexec/tama-bridge.py
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
RestrictAddressFamilies=AF_VSOCK AF_UNIX

[Install]
WantedBy=multi-user.target
